<?xml version="1.0" encoding="utf-8"?>
<!-- GameActivity launcher for the Rust preview. The native library is
     libvelta_preview.so, built by cargo with the `game-activity` feature
     and copied into app/src/main/jniLibs/arm64-v8a/. adjustResize makes
     the window relayout around the soft keyboard (composer, #315). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Velta Preview"
        android:allowBackup="false">
        <activity
            android:name="com.google.androidgamesdk.GameActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|density|uiMode|navigation|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="velta_preview" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
