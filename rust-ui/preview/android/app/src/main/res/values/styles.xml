<?xml version="1.0" encoding="utf-8"?>
<!-- AppCompatActivity (GameActivity's base class) refuses to start without
     an AppCompat descendant theme. Dark + no action bar: Masonry paints the
     whole surface itself. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VeltaPreview" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>
</resources>
