<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core sockets (IMAP/SMTP + the loopback RPC shim) need INTERNET;
         Android gates every AF_INET socket, loopback included, on it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep the core syncing while the screen is off (P4 slice 6). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Battery-saver exemptions keep the sync service alive on OEM ROMs
         (P4 slice 10); the system dialog lets the user decide. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Invite-QR scanning (P4 slice 11b): camera only while the scan screen
         is open; ZXing decodes locally, nothing leaves the device. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:label="Velta KMP"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.VeltaForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".push.VeltaPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".scan.ScanActivity"
            android:exported="false" />
    </application>
</manifest>
