<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core sockets (IMAP/SMTP + the loopback RPC shim) need INTERNET;
         Android gates every AF_INET socket, loopback included, on it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep the core syncing while the screen is off (P4 slice 6). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Battery-saver exemptions keep the sync service alive on OEM ROMs
         (P4 slice 10); the system dialog lets the user decide. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Periodic catch-up (BackgroundFetchJob): a persisted JobScheduler job
         needs this to survive a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Invite-QR scanning (P4 slice 11b): camera only while the scan screen
         is open; ZXing decodes locally, nothing leaves the device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice messages (#334 step 11): the mic only while recording. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Custom Tabs (InAppBrowser): without these, package visibility hides
         every provider on API 30+ and a link opens as a full browser task. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="Velta KMP"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invite links (#334, stable's filters): contact/group invites
                 and chatmail scheme codes land on the welcome splash or the
                 Join screen. velta.cc is path-scoped to /join/ so ordinary
                 site taps stay in the browser (stable manifest, step 7). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="velta.cc" android:pathPrefix="/join/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="i.delta.chat" />
                <data android:scheme="https" android:host="i.deltachat.id" />
                <data android:scheme="https" android:host="i.gluek.info" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dcaccount" />
                <data android:scheme="dclogin" />
                <data android:scheme="dcbackup" />
                <data android:scheme="openpgp4fpr" />
            </intent-filter>
            <!-- #334 step 7 (stable #97): Velta in the system share sheet.
                 singleTask (as stable) so a share lands in the running app
                 instead of a second copy inside the sender's task. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


        <service
            android:name=".core.VeltaForegroundService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- Periodic catch-up (#358): 15-minute JobScheduler fetch, stable's
             BackgroundFetchJob; covers no push distributor and OEM freezers. -->
        <service
            android:name=".core.BackgroundFetchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".push.VeltaPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".scan.ScanActivity"
            android:exported="false" />
    </application>
</manifest>
