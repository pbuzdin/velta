{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Mobile permissions for Velta",
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:allow-unlisten",
    "opener:default",
    "dialog:allow-open",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "fs:scope-applocaldata-recursive"
  ]
}
