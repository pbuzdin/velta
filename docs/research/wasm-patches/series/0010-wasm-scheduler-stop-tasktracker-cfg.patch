Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

TaskTracker::spawn panics on wasm32 ("there is no reactor running"):
tokio_util rides the real tokio, which has no runtime in the browser.
Gate the tracker path (and its import) to native; wasm32 spawns the
shutdown waits directly onto the velta-tokio-wasm event loop, keeping
upstream 2.64's timeout-then-abort semantics (#8832).

Native impact: none — native keeps the original code path.
---
 src/scheduler.rs | 95 ++++++++++++++++++++++++++++++++++--------------
 1 file changed, 68 insertions(+), 27 deletions(-)

diff --git a/src/scheduler.rs b/src/scheduler.rs
index fc6a124..a29c057 100644
--- a/src/scheduler.rs
+++ b/src/scheduler.rs
@@ -11,6 +11,7 @@
 use tokio::sync::{RwLock, oneshot};
 use tokio::task::{self, JoinSet};
 use tokio_util::sync::CancellationToken;
+#[cfg(not(target_arch = "wasm32"))]
 use tokio_util::task::TaskTracker;
 
 pub(crate) use self::connectivity::ConnectivityStore;
@@ -850,36 +851,76 @@ pub(crate) async fn stop(self, context: &Context) {
         // Actually shutdown tasks.
         let timeout_duration = std::time::Duration::from_secs(30);
 
-        let tracker = TaskTracker::new();
-        for mut b in self.inboxes {
-            let context = context.clone();
-            tracker.spawn(async move {
-                if tokio::time::timeout(timeout_duration, &mut b.handle)
-                    .await
-                    .is_err()
-                {
-                    warn!(context, "IMAP shutdown timed out; aborting task.");
-                    b.handle.abort();
-                    b.handle.await.ok();
-                }
-            });
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            let tracker = TaskTracker::new();
+            for mut b in self.inboxes {
+                let context = context.clone();
+                tracker.spawn(async move {
+                    if tokio::time::timeout(timeout_duration, &mut b.handle)
+                        .await
+                        .is_err()
+                    {
+                        warn!(context, "IMAP shutdown timed out; aborting task.");
+                        b.handle.abort();
+                        b.handle.await.ok();
+                    }
+                });
+            }
+            {
+                let context = context.clone();
+                tracker.spawn(async move {
+                    let mut handle = self.smtp_handle;
+                    if tokio::time::timeout(timeout_duration, &mut handle)
+                        .await
+                        .is_err()
+                    {
+                        warn!(context, "SMTP shutdown timed out; aborting task.");
+                        handle.abort();
+                        handle.await.ok();
+                    }
+                });
+            }
+            tracker.close();
+            tracker.wait().await;
         }
+        // wasm32: tokio_util::TaskTracker rides the real tokio, which has no
+        // runtime in the browser — spawn the shutdown waits onto the
+        // velta-tokio-wasm event loop directly instead (same timeout + abort).
+        #[cfg(target_arch = "wasm32")]
         {
-            let context = context.clone();
-            tracker.spawn(async move {
-                let mut handle = self.smtp_handle;
-                if tokio::time::timeout(timeout_duration, &mut handle)
-                    .await
-                    .is_err()
-                {
-                    warn!(context, "SMTP shutdown timed out; aborting task.");
-                    handle.abort();
-                    handle.await.ok();
-                }
-            });
+            let mut handles = Vec::new();
+            for mut b in self.inboxes {
+                let context = context.clone();
+                handles.push(tokio::spawn(async move {
+                    if tokio::time::timeout(timeout_duration, &mut b.handle)
+                        .await
+                        .is_err()
+                    {
+                        warn!(context, "IMAP shutdown timed out; aborting task.");
+                        b.handle.abort();
+                        b.handle.await.ok();
+                    }
+                }));
+            }
+            {
+                let context = context.clone();
+                handles.push(tokio::spawn(async move {
+                    let mut handle = self.smtp_handle;
+                    if tokio::time::timeout(timeout_duration, &mut handle)
+                        .await
+                        .is_err()
+                    {
+                        warn!(context, "SMTP shutdown timed out; aborting task.");
+                        handle.abort();
+                        handle.await.ok();
+                    }
+                }));
+            }
+            for h in handles {
+                h.await.ok();
+            }
         }
-        tracker.close();
-        tracker.wait().await;
 
         // Abort tasks, then await them to ensure the `Future` is dropped.
         // Just aborting the task may keep resources such as `Context` clone
