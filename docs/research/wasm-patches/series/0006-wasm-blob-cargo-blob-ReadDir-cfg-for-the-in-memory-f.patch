From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: spike <spike@local>
Date: Mon, 5 Oct 2026 22:04:38 +0300
Subject: [PATCH] wasm(blob,cargo): blob ReadDir cfg for the in-memory fs,
 serde_urlencoded

The wasm fs shim's ReadDir is already a Stream, so skip ReadDirStream on
wasm32. Add serde_urlencoded for fetch-based form posts. (The vendored
async-imap 0.11.3 built without its net feature lives in
support/vendor-crates/.)

WASM-CORE: prototype 0004 (MPL idea). Native impact: none.
---
 Cargo.toml  | 1 +
 src/blob.rs | 8 +++++++-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/Cargo.toml b/Cargo.toml
index 2f5664d..ba93277 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -135,6 +135,7 @@ wasm-bindgen = "0.2"
 wasm-bindgen-futures = "0.4"
 web-sys = { version = "0.3", features = ["AbortController", "AbortSignal", "Headers", "RequestInit", "RequestRedirect", "Response", "WorkerGlobalScope"] }
 ws_stream_wasm = "0.7"
+serde_urlencoded = "0.7.1"
 
 [dev-dependencies]
 anyhow = { workspace = true, features = ["backtrace"] } # Enable `backtrace` feature in tests.
diff --git a/src/blob.rs b/src/blob.rs
index f3432cd..c5d4ed6 100644
--- a/src/blob.rs
+++ b/src/blob.rs
@@ -14,6 +14,7 @@
 use image::{codecs::jpeg::JpegEncoder, metadata::Orientation};
 use num_traits::{FromPrimitive, cast};
 use tokio::{fs, task};
+#[cfg(not(target_arch = "wasm32"))]
 use tokio_stream::wrappers::ReadDirStream;
 
 use crate::config::Config;
@@ -621,7 +622,12 @@ pub(crate) struct BlobDirContents<'a> {
 impl<'a> BlobDirContents<'a> {
     pub(crate) async fn new(context: &'a Context) -> Result<BlobDirContents<'a>> {
         let readdir = fs::read_dir(context.get_blobdir()).await?;
-        let inner = ReadDirStream::new(readdir)
+        // The wasm fs shim's ReadDir implements Stream itself.
+        #[cfg(target_arch = "wasm32")]
+        let readdir_stream = readdir;
+        #[cfg(not(target_arch = "wasm32"))]
+        let readdir_stream = ReadDirStream::new(readdir);
+        let inner = readdir_stream
             .filter_map(|entry| async move {
                 match entry {
                     Ok(entry) => Some(entry),
