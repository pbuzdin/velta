diff --git a/src/sql.rs b/src/sql.rs
index 9a29607..da78b03 100644
--- a/src/sql.rs
+++ b/src/sql.rs
@@ -88,6 +88,51 @@ fn note_slow_sql(query_only: bool, wait_ms: u128, hold_ms: u128) {
     }
 }
 
+/// Magic bytes of an unencrypted SQLite database (16 bytes including NUL).
+#[cfg(target_arch = "wasm32")]
+const SQLITE_PLAIN_HEADER: &[u8] = b"SQLite format 3\0";
+
+#[cfg(target_arch = "wasm32")]
+type WasmMemVfs = sqlite_wasm_rs::MemVfsUtil<sqlite_wasm_rs::WasmOsCallback>;
+
+/// Copy a database from sqlite-wasm-rs's memory VFS into tokio memfs, then
+/// drop the VFS copy. `VACUUM INTO` and `ATTACH` write only to the SQLite
+/// VFS; the backup tar packer reads tokio memfs.
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn wasm_sqlite_export_to_memfs(dest: &str) -> Result<()> {
+    let util = WasmMemVfs::new();
+    let bytes = util
+        .export_db(dest)
+        .map_err(|e| anyhow::anyhow!("failed to export backup database from sqlite vfs: {e}"))?;
+    util.delete_db(dest);
+    if let Some(parent) = Path::new(dest).parent() {
+        tokio::fs::sync_create_dir_all(parent)
+            .with_context(|| format!("failed to create backup directory {}", parent.display()))?;
+    }
+    tokio::fs::sync_write(dest, &bytes)
+        .with_context(|| format!("failed to write backup database to {dest}"))?;
+    Ok(())
+}
+
+/// Replace the live account database in sqlite-wasm-rs's memory VFS.
+/// The connection pool must already be closed.
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn wasm_sqlite_replace_db(name: &str, data: &[u8]) -> Result<()> {
+    if !data.starts_with(SQLITE_PLAIN_HEADER) {
+        bail!(
+            "This backup is encrypted and cannot be imported in the browser. Restore it in the desktop or Android app, or export an unencrypted backup."
+        );
+    }
+    let util = WasmMemVfs::new();
+    util.delete_db(name);
+    util.delete_db(&format!("{name}-wal"));
+    util.delete_db(&format!("{name}-shm"));
+    util.delete_db(&format!("{name}-journal"));
+    util.import_db(name, data)
+        .map_err(|e| anyhow::anyhow!("failed to import backup database into sqlite vfs: {e}"))?;
+    Ok(())
+}
+
 impl Sql {
     /// Creates new SQL database.
     pub fn new(dbfile: PathBuf) -> Sql {
@@ -150,11 +195,6 @@ pub(crate) async fn close(&self) {
 
     /// Imports the database from a separate file with the given passphrase.
     pub(crate) async fn import(&self, path: &Path, passphrase: String) -> Result<()> {
-        let path_str = path
-            .to_str()
-            .with_context(|| format!("path {path:?} is not valid unicode"))?
-            .to_string();
-
         // Keep `config_cache` locked all the time the db is imported so that nobody can use invalid
