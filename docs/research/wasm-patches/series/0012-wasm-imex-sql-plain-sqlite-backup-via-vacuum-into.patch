+                        "Passphrase-protected backups are not supported in the browser. Export without a passphrase, or use the desktop or Android app."
+                    );
+                }
+                conn.execute("VACUUM INTO ?", (dest,))
+                    .context("failed to vacuum into backup database")?;
+                conn.execute("ATTACH DATABASE ? AS backup", (dest,))
+                    .context("failed to attach backup database")?;
+                conn.execute(
+                    "UPDATE backup.config SET value='0' WHERE keyname='verified_one_on_one_chats';",
+                    [],
+                )
+                .ok(); // Deprecated 2025-07. If verified_one_on_one_chats was not set, this errors, which we ignore
+                conn.execute("DETACH DATABASE backup", [])
