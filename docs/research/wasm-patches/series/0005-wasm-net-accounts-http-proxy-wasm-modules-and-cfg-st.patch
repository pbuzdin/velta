diff --git a/src/net/http_wasm.rs b/src/net/http_wasm.rs
new file mode 100644
index 0000000..9e1d853
--- /dev/null
+++ b/src/net/http_wasm.rs
@@ -0,0 +1,265 @@
+//! wasm32 HTTP module backed by the browser `fetch()` API.
+//!
+//! The native implementation uses hyper over raw TCP. Here the browser owns
+//! the connection: TLS, redirects and caching are handled by `fetch()`, and
+//! requests are subject to CORS.
+
+use std::time::Duration;
+
+use anyhow::{Context as _, Result, anyhow, bail};
+use futures::channel::oneshot;
+use mime::Mime;
+use serde::Serialize;
+use wasm_bindgen::{JsCast, JsValue};
+use wasm_bindgen_futures::JsFuture;
+
+use crate::context::Context;
+
+/// Default timeout for the `read_url*`/`post_*` wrappers.
+const DEFAULT_TIMEOUT: Duration = Duration::from_secs(60);
+
+/// HTTP(S) GET response.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Response {
+    /// Response body.
+    pub blob: Vec<u8>,
+
+    /// MIME type extracted from the `Content-Type` header, if any.
+    pub mimetype: Option<String>,
+
+    /// Encoding extracted from the `Content-Type` header, if any.
+    pub encoding: Option<String>,
+}
+
+/// The parts of a `fetch()` response we use; unlike JS handles, all Send.
+struct FetchResponse {
+    status: u16,
+    ok: bool,
+    content_type: Option<String>,
+    body: Vec<u8>,
+}
+
+fn js_str(v: JsValue) -> String {
+    format!("{v:?}")
+}
+
+/// Runs `fetch()` on the worker's JS event loop.
+///
+/// JS handles are `!Send` but our futures must be Send (yerpc), so the JS
+/// side runs in a `spawn_local` task and the result comes back over a
+/// oneshot channel — same pattern as `ws_tcp`.
+///
+/// Fails if no response arrived within `timeout`; the fetch is aborted
+/// via an `AbortController` then (browser `fetch()` has no timeout of
+/// its own).
+///
+/// With `follow_redirects` the browser follows redirects transparently
+/// (its default); without it a redirect fails the request
+/// (`RequestRedirect::Error`), so request headers such as credentials
+/// are never re-sent to a redirect target.
+async fn fetch(
+    method: &str,
+    url: &str,
+    headers: &[(&str, &str)],
+    body: Option<String>,
+    timeout: Duration,
+    follow_redirects: bool,
+) -> Result<FetchResponse> {
+    let method = method.to_string();
+    let url = url.to_string();
+    let headers: Vec<(String, String)> = headers
+        .iter()
+        .map(|(name, value)| (name.to_string(), value.to_string()))
+        .collect();
+    let (tx, rx) = oneshot::channel();
+    wasm_bindgen_futures::spawn_local(async move {
+        let controller = web_sys::AbortController::new().ok();
+        let result = match tokio::time::timeout(
+            timeout,
+            fetch_inner(
+                &method,
+                &url,
+                &headers,
+                body,
+                follow_redirects,
+                controller.as_ref(),
+            ),
+        )
+        .await
+        {
+            Ok(result) => result,
+            Err(_elapsed) => {
+                if let Some(controller) = &controller {
+                    controller.abort();
+                }
+                Err("request timed out".to_string())
+            }
+        };
+        let _ = tx.send(result.map_err(|e| format!("{method} {e}")));
+    });
+    rx.await
+        .map_err(|_| anyhow!("fetch task dropped"))?
+        .map_err(|e| anyhow!("fetch {e}"))
+}
+
+async fn fetch_inner(
+    method: &str,
+    url: &str,
+    headers: &[(String, String)],
+    body: Option<String>,
+    follow_redirects: bool,
+    controller: Option<&web_sys::AbortController>,
+) -> std::result::Result<FetchResponse, String> {
+    let init = web_sys::RequestInit::new();
+    init.set_method(method);
+    if !follow_redirects {
+        init.set_redirect(web_sys::RequestRedirect::Error);
+    }
+    if let Some(controller) = controller {
+        init.set_signal(Some(&controller.signal()));
+    }
+    if let Some(body) = &body {
+        init.set_body(&JsValue::from_str(body));
+    }
+    if !headers.is_empty() {
+        let js_headers = web_sys::Headers::new().map_err(js_str)?;
+        for (name, value) in headers {
+            js_headers.append(name, value).map_err(js_str)?;
+        }
+        init.set_headers(&js_headers);
+    }
+    // The core always runs in a Web Worker; there is no `window` global.
+    let scope: web_sys::WorkerGlobalScope = js_sys::global().unchecked_into();
+    let resp: web_sys::Response = JsFuture::from(scope.fetch_with_str_and_init(url, &init))
+        .await
+        .map_err(js_str)?
+        .unchecked_into();
+    let buf = JsFuture::from(resp.array_buffer().map_err(js_str)?)
+        .await
+        .map_err(js_str)?;
+    Ok(FetchResponse {
+        status: resp.status(),
+        ok: resp.ok(),
+        content_type: resp.headers().get("content-type").ok().flatten(),
+        body: js_sys::Uint8Array::new(&buf).to_vec(),
+    })
+}
+
+/// POST endpoints carry tokens; https only, as on native.
+fn ensure_https(url: &str) -> Result<()> {
+    if !url.starts_with("https://") {
+        bail!("POST requests to non-HTTPS URLs are not allowed");
+    }
+    Ok(())
+}
+
+/// Performs a single HTTP request via `fetch()`.
+///
+/// Returns the status code and the response body instead of failing
+/// on non-2xx responses. See [`fetch`] for `timeout` and
+/// `follow_redirects` semantics.
+pub(crate) async fn request(
+    _context: &Context,
+    method: &str,
+    url: &str,
+    headers: &[(&str, &str)],
+    body: Option<String>,
+    timeout: Duration,
+    follow_redirects: bool,
+) -> Result<(u16, Response)> {
+    let resp = fetch(method, url, headers, body, timeout, follow_redirects).await?;
+    let content_type = resp.content_type.and_then(|v| v.parse::<Mime>().ok());
+    let mimetype = content_type.as_ref().map(|m| m.essence_str().to_string());
+    let encoding = content_type
+        .as_ref()
+        .and_then(|m| m.get_param(mime::CHARSET))
+        .map(|c| c.as_str().to_string());
+    Ok((
+        resp.status,
+        Response {
+            blob: resp.body,
+            mimetype,
+            encoding,
+        },
+    ))
+}
+
+/// Retrieves the text contents of URL using HTTP GET request.
+pub async fn read_url(context: &Context, url: &str) -> Result<String> {
+    let response = read_url_blob(context, url).await?;
+    Ok(String::from_utf8_lossy(&response.blob).to_string())
+}
+
+/// Retrieves the text contents of URL using HTTP GET request.
+pub(crate) async fn read_url_with_tls(
+    context: &Context,
+    url: &str,
+    _strict_tls: bool,
+) -> Result<String> {
+    // The browser owns TLS on the fetch path; `strict_tls` has no meaning here.
+    read_url(context, url).await
+}
+
+/// Removes expired cache entries.
+pub(crate) async fn http_cache_cleanup(_context: &Context) -> Result<()> {
+    // No core-side HTTP cache on wasm; the browser HTTP cache covers GETs.
+    Ok(())
+}
+
+/// Retrieves the binary contents of URL using HTTP GET request.
+pub async fn read_url_blob(context: &Context, url: &str) -> Result<Response> {
+    let (status, response) = request(context, "GET", url, &[], None, DEFAULT_TIMEOUT, true).await?;
+    if !(200..300).contains(&status) {
+        bail!("The server returned a non-successful response code: {status}");
+    }
+    Ok(response)
+}
+
+/// Retrieves the binary contents of URL using HTTP GET request.
+#[allow(dead_code)] // API parity with net/http.rs; callers are native-only today
+pub(crate) async fn read_url_blob_with_tls(
+    context: &Context,
+    url: &str,
+    _strict_tls: bool,
+) -> Result<Response> {
+    read_url_blob(context, url).await
+}
+
+/// Sends an empty POST request to the URL.
+///
+/// Returns response text and whether request was successful.
+pub(crate) async fn post_empty(_context: &Context, url: &str) -> Result<(String, bool)> {
+    ensure_https(url)?;
+    let resp = fetch("POST", url, &[], None, DEFAULT_TIMEOUT, true).await?;
+    Ok((String::from_utf8_lossy(&resp.body).to_string(), resp.ok))
+}
+
+/// Sends a POST request with given string as body.
+#[allow(dead_code)] // API parity with net/http.rs; callers are native-only today
+pub(crate) async fn post_string(_context: &Context, url: &str, body: String) -> Result<bool> {
+    ensure_https(url)?;
+    Ok(fetch("POST", url, &[], Some(body), DEFAULT_TIMEOUT, true)
+        .await?
+        .ok)
+}
+
+/// Posts the given form to the URL.
+#[allow(dead_code)] // API parity with net/http.rs; callers are native-only today
+pub(crate) async fn post_form<T: Serialize + ?Sized>(
+    _context: &Context,
+    url: &str,
+    form: &T,
+) -> Result<bytes::Bytes> {
+    ensure_https(url)?;
+    let body = serde_urlencoded::to_string(form).context("Failed to encode data")?;
+    let resp = fetch(
+        "POST",
+        url,
+        &[("content-type", "application/x-www-form-urlencoded")],
+        Some(body),
+        DEFAULT_TIMEOUT,
+        true,
+    )
+    .await?;
+    Ok(resp.body.into())
+}
diff --git a/src/net/proxy_wasm.rs b/src/net/proxy_wasm.rs
