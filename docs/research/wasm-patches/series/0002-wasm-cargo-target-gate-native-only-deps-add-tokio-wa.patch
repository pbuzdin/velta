From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: spike <spike@local>
Date: Sun, 11 Oct 2026 00:12:12 +0300
Subject: [PATCH] wasm(cargo): target-gate native-only deps, add
 velta-tokio-wasm, rusqlite 0.40

Gate native-only dependencies behind cfg(not(target_arch = "wasm32")),
add the wasm32 dependency table (chrono wasmbind, tokio-rustls on ring,
getrandom js, pgp wasm, wasm-bindgen, web-sys, ws_stream_wasm) and the
getrandom wasm_js backend in .cargo/config.toml.

Quilt-refreshed for core 2.63 (#112): async-imap 0.12, pgp 0.21 (wasm
feature on wasm32), astral-tokio-tar 0.7.0 (pinned =0.6.4 vendored in
0004), base64 0.23 / mailparse 0.17 workspace deps. deltachat-time is
dev-only upstream now - wasm32 keeps a path dep for the JS clock.
Upstream dropped sdp/tracing deps - not re-added.

2.66 refresh (#260/#261): #22 added velta-attachment (path dep, kept
ungated: std::fs stubs compile on wasm32 and the wasm build never holds
a key) + runtime tempfile; upstream gave tokio-util an io feature.
Cargo hunks regenerated against that state — including the workspace
rusqlite 0.37 -> 0.40 bump and the [target] tables re-homed to the
[dependencies] boundary (the old hunks' layout collided with #22's
dep insertions).

rusqlite 0.37 -> 0.40 (+ "fallible_uint") is required for the
sqlite-wasm-rs backend. NOTE: this also bumps NATIVE builds:
libsqlite3-sys 0.35 -> 0.38, bundled SQLCipher 4.6.1 (SQLite 3.46.1) ->
4.14.0 (SQLite 3.51.3), hashlink 0.10 -> 0.12. See landing checklist.

WASM-CORE: prototype 0001 (MPL idea).
---
 .cargo/config.toml           |  3 ++
 Cargo.toml                   | 54 ++++++++++++++++++++++++++----------
 deltachat-jsonrpc/Cargo.toml |  2 +-
 3 files changed, 44 insertions(+), 15 deletions(-)

diff --git a/.cargo/config.toml b/.cargo/config.toml
index e2e5fa9..e443b86 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -9,3 +9,6 @@
 # invoking `cargo test` threads are allowed to have a large enough
 # stack size without needing to use an optimised build.
 RUST_MIN_STACK = "8388608"
+
+[target.wasm32-unknown-unknown]
+rustflags = ["--cfg", 'getrandom_backend="wasm_js"']
diff --git a/Cargo.toml b/Cargo.toml
index 928326e..87185ab 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -45,9 +45,7 @@ anyhow = { workspace = true }
 async-broadcast = "0.7.2"
 async-channel = { workspace = true }
 async-imap = { version = "0.12.0", default-features = false, features = ["runtime-tokio", "compress"] }
-async-native-tls = { version = "0.6", default-features = false, features = ["runtime-tokio"] }
 async-smtp = { version = "0.10.2", default-features = false, features = ["runtime-tokio"] }
-async_zip = { version = "0.0.18", default-features = false, features = ["deflate", "tokio-fs"] }
 base64 = { workspace = true }
 blake3 = "1.8.2"
 brotli = { version = "8", default-features=false, features = ["std"] }
@@ -56,15 +54,10 @@ chrono = { workspace = true, features = ["alloc", "clock", "std"] }
 colorutils-rs = { version = "0.8.0", default-features = false }
 data-encoding = "2.9.0"
 escaper = "0.1"
-fast-socks5 = "1"
-fd-lock = "4"
 futures-lite = { workspace = true }
 futures = { workspace = true }
 hex = "0.4.0"
-http-body-util = "0.1.3"
 humansize = "2"
-hyper = "1"
-hyper-util = "0.1.16"
 image = { version = "0.25.6", default-features=false, features = ["gif", "jpeg", "ico", "png", "pnm", "webp", "bmp"] }
 iroh-gossip = { version = "0.35", default-features = false, features = ["net"] }
 iroh = { version = "0.35", default-features = false }
@@ -85,13 +78,12 @@ quick-xml = { version = "0.41", features = ["escape-html"] }
 rand-old = { package = "rand", version = "0.8" }
 rand = { workspace = true }
 regex = { workspace = true }
-rusqlite = { workspace = true, features = ["sqlcipher"] }
+rusqlite = { workspace = true, features = ["sqlcipher", "fallible_uint"] }
 sanitize-filename = { workspace = true }
 serde_json = { workspace = true }
 serde = { workspace = true, features = ["derive"] }
 sha-1 = "0.10"
 sha2 = "0.10"
-shadowsocks = { version = "1.23.1", default-features = false, features = ["aead-cipher", "aead-cipher-2022"] }
 smallvec = "1.15.1"
 strum = "0.28"
 strum_macros = "0.28"
@@ -100,17 +92,51 @@ tempfile = { workspace = true }
 textwrap = "0.16.2"
 thiserror = { workspace = true }
 tokio-io-timeout = "1.2.1"
-tokio-rustls = { version = "0.26.2", default-features = false, features = ["tls12", "brotli"] }
-tokio-stream = { version = "0.1.17", features = ["fs"] }
-astral-tokio-tar = { version = "0.7.0", default-features = false }
+# Velta wasm port: tokio facade (real tokio on native, browser shims on wasm32).
+# Path relative to the apply-on-copy layout <dest>/{core,crates,vendor-crates}.
+tokio = { package = "velta-tokio-wasm", path = "../crates/velta-tokio-wasm" }
 tokio-util = { workspace = true, features = ["io"] }
-tokio = { workspace = true, features = ["fs", "rt-multi-thread", "macros"] }
+# tar via vendored fork that routes through the shim (see [patch.crates-io])
+astral-tokio-tar = { version = "0.7.0", default-features = false }
 toml = "0.9"
 url = "2"
 uuid = { version = "1", features = ["serde", "v4"] }
 walkdir = "2.5.0"
 webpki-roots = "1.0.10"
 
+
+[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
+async-native-tls = { version = "0.6", default-features = false, features = ["runtime-tokio"] }
+async_zip = { version = "0.0.18", default-features = false, features = ["deflate", "tokio-fs"] }
+fast-socks5 = "1"
+fd-lock = "4"
+http-body-util = "0.1.3"
+hyper = "1"
+hyper-util = "0.1.16"
+shadowsocks = { version = "1.23.1", default-features = false, features = ["aead-cipher", "aead-cipher-2022"] }
+# Velta 2.63 uses brotli on native tokio-rustls (upstream change vs 2.54 aws-lc-rs)
+tokio-rustls = { version = "0.26.2", default-features = false, features = ["tls12", "brotli"] }
+tokio-stream = { version = "0.1.17", features = ["fs"] }
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+async_zip = { version = "0.0.18", default-features = false, features = ["deflate", "tokio"] }
+chrono = { workspace = true, features = ["wasmbind"] }
+# 2.63 moved deltachat-time to dev-deps upstream; wasm32 keeps it as a prod
+# dep for the JS-clock SystemTimeTools (tools.rs re-export, see 0007).
+deltachat-time = { path = "./deltachat-time" }
+tokio-rustls = { version = "0.26.2", default-features = false, features = ["ring", "tls12"] }
+tokio-stream = { version = "0.1.17" }
+getrandom = { version = "0.3", features = ["wasm_js"] }
+getrandom-old = { package = "getrandom", version = "0.2", features = ["js"] }
+js-sys = "0.3"
+pgp = { version = "0.21.0", default-features = false, features = ["wasm"] }
+tokio-util = { workspace = true, features = ["compat"] }
+uuid = { version = "1", features = ["js"] }
+wasm-bindgen = "0.2"
+wasm-bindgen-futures = "0.4"
+web-sys = { version = "0.3", features = ["AbortController", "AbortSignal", "Headers", "RequestInit", "RequestRedirect", "Response", "WorkerGlobalScope"] }
+ws_stream_wasm = "0.7"
+
 [dev-dependencies]
 anyhow = { workspace = true, features = ["backtrace"] } # Enable `backtrace` feature in tests.
 criterion = { version = "0.8.1", features = ["async_tokio"] }
@@ -194,7 +220,7 @@ nu-ansi-term = "0.50"
 num-traits = "0.2"
 rand = "0.9"
 regex = "1.12"
-rusqlite = "0.37"
+rusqlite = "0.40"
 sanitize-filename = "0.6"
 serde = "1.0"
 serde_json = "1"
diff --git a/deltachat-jsonrpc/Cargo.toml b/deltachat-jsonrpc/Cargo.toml
index 88c5442..d3e0510 100644
--- a/deltachat-jsonrpc/Cargo.toml
+++ b/deltachat-jsonrpc/Cargo.toml
@@ -17,7 +17,7 @@ async-channel = { workspace = true }
 serde_json = { workspace = true }
 yerpc = { workspace = true, features = ["anyhow_expose", "openrpc"] }
 typescript-type-def = { version = "0.5.13", features = ["json_value"] }
-tokio = { workspace = true }
+tokio = { package = "velta-tokio-wasm", path = "../../crates/velta-tokio-wasm" }
 sanitize-filename = { workspace = true }
 base64 = { workspace = true }
 
-- 
2.43.0

