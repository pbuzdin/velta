From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: spike <spike@local>
Date: Mon, 5 Oct 2026 21:55:53 +0300
Subject: [PATCH] wasm(cargo): route tokio through tokio-wasm-shim in every
 workspace crate

Cargo allows one source per dependency name across all targets, so every
crate that names `tokio` must use the same facade. tokio-wasm-shim is a
transparent `pub use tokio::*` (features = "full") on native; drop the
now-redundant root dev-dependency.

WASM-CORE: prototype 0001 (MPL idea). Native impact: tokio feature set
becomes "full" for ffi / rpc-server / repl / jsonrpc tests (superset).
---
 Cargo.toml                      | 1 -
 deltachat-ffi/Cargo.toml        | 2 +-
 deltachat-jsonrpc/Cargo.toml    | 2 +-
 deltachat-repl/Cargo.toml       | 2 +-
 deltachat-rpc-server/Cargo.toml | 2 +-
 5 files changed, 4 insertions(+), 5 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index e7efaa3..de76ce3 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -146,7 +146,6 @@ pretty_assertions = "1.4.1"
 proptest = { version = "1", default-features = false, features = ["std"] }
 tempfile = { workspace = true }
 testdir = "0.9.3"
-tokio = { workspace = true, features = ["rt-multi-thread", "macros"] }
 
 [workspace]
 members = [
diff --git a/deltachat-ffi/Cargo.toml b/deltachat-ffi/Cargo.toml
index 1c943eb..7492b25 100644
--- a/deltachat-ffi/Cargo.toml
+++ b/deltachat-ffi/Cargo.toml
@@ -19,7 +19,7 @@ libc = { workspace = true }
 human-panic = { version = "2", default-features = false }
 num-traits = { workspace = true }
 serde_json = { workspace = true }
-tokio = { workspace = true, features = ["rt-multi-thread"] }
+tokio = { package = "tokio-wasm-shim", path = "../../crates/tokio-wasm-shim" }
 anyhow = { workspace = true }
 thiserror = { workspace = true }
 rand = { workspace = true }
diff --git a/deltachat-jsonrpc/Cargo.toml b/deltachat-jsonrpc/Cargo.toml
index 82a7c13..e578c29 100644
--- a/deltachat-jsonrpc/Cargo.toml
+++ b/deltachat-jsonrpc/Cargo.toml
@@ -22,7 +22,7 @@ sanitize-filename = { workspace = true }
 base64 = { workspace = true }
 
 [dev-dependencies]
-tokio = { workspace = true, features = ["full", "rt-multi-thread"] }
+tokio = { package = "tokio-wasm-shim", path = "../../crates/tokio-wasm-shim" }
 tempfile = { workspace = true }
 futures = { workspace = true }
 
diff --git a/deltachat-repl/Cargo.toml b/deltachat-repl/Cargo.toml
index 704bace..32a35e5 100644
--- a/deltachat-repl/Cargo.toml
+++ b/deltachat-repl/Cargo.toml
@@ -14,7 +14,7 @@ nu-ansi-term = { workspace = true }
 qr2term = "0.3.3"
 rusqlite = { workspace = true }
 rustyline = "16"
-tokio = { workspace = true, features = ["fs", "rt-multi-thread", "macros"] }
+tokio = { package = "tokio-wasm-shim", path = "../../crates/tokio-wasm-shim" }
 tracing-subscriber = { workspace = true, features = ["env-filter"] }
 
 [features]
diff --git a/deltachat-rpc-server/Cargo.toml b/deltachat-rpc-server/Cargo.toml
index 99e7d92..23480d3 100644
--- a/deltachat-rpc-server/Cargo.toml
+++ b/deltachat-rpc-server/Cargo.toml
@@ -17,7 +17,7 @@ futures-lite = { workspace = true }
 log = { workspace = true }
 serde_json = { workspace = true }
 serde = { workspace = true, features = ["derive"] }
-tokio = { workspace = true, features = ["io-std"] }
+tokio = { package = "tokio-wasm-shim", path = "../../crates/tokio-wasm-shim" }
 tokio-util = { workspace = true }
 tracing-subscriber = { workspace = true, features = ["env-filter"] }
 yerpc = { workspace = true, features = ["anyhow_expose", "openrpc"] }
