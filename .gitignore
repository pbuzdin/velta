# Prebuilt sidecar / backend binaries (built in CI or locally)
# -----------------------------------------------------------------------------
deltachat-backend/
deltachat-backend.zip
delta-web-app/src-tauri/binaries/*.exe
delta-web-app/Velta_*.apk
signing/

