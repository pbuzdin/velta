<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Background sync: the CoreService foreground service keeps the
         process (with the in-process Delta Chat core) alive after the user
         leaves the app. remoteMessaging has no Android 15 time cap. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Media access for picking attachments (Android 13+ granular permissions). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Incoming-message notifications (Android 13+ runtime permission;
         requested from the WebView via tauri-plugin-notification). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR scanning: getUserMedia in the WebView only works if CAMERA is
         declared; wry forwards the WebView's permission request to the OS
         when the user starts a scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Custom Tabs provider resolution (InAppBrowser.kt): without this query,
         package visibility hides every provider on API 30+ and links fall
         back to the default browser as a full task. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Lets InAppBrowser resolve the user's default browser (to prefer
             it as the custom tab provider); package visibility hides the
             default on API 30+ without this declaration. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- No hardcoded android:debuggable: release APKs must not be
         debuggable (run-as would expose the account databases and keys).
         Debug builds get it from build.gradle.kts (isDebuggable = true), so
         run-as log access keeps working there.
         allowBackup/fullBackupContent off: the app data holds private keys
         and must not be copied into OS or cloud backups. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.velta_app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Open https://i.delta.chat/#… invite links inside Velta.
                 Mirror domains belong here too — one intent-filter each; the
                 runtime-recognized list lives in app/js/invites.js (the
                 drawer's "Invite link domains" setting). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="i.delta.chat" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="i.gluek.info" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="i.deltachat.id" />
            </intent-filter>
            <!-- Chatmail scheme links (scanned QR codes, taps in other apps):
                 account creation (dcaccount:), login to an existing relay
                 account (dclogin:), second-device transfers (dcbackup:), and
                 SecureJoin invites as text QRs (openpgp4fpr:) — without this
                 scheme entry Android only offers other Delta Chat clients
                 (Delta Chat, ArcaneChat) as handlers. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dcaccount" />
                <data android:scheme="dclogin" />
                <data android:scheme="dcbackup" />
                <data android:scheme="openpgp4fpr" />
            </intent-filter>
        </activity>

        <!-- Keeps the core running in the background; started from
             MainActivity.onCreate. -->
        <service
            android:name=".CoreService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- UnifiedPush connector: receives push events (endpoint
             registrations + wake-ups) from the user-chosen distributor app
             and forwards them into the Rust core via JNI
             (UnifiedPushService.kt / lib.rs). -->
        <service
            android:name=".UnifiedPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
