<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted app-wide for the in-app browser: user-opened
     http:// links (old sites, http-only redirects) must render in the
     second WebView, and Android 9+ blocks cleartext otherwise
     (net::ERR_CLEARTEXT_NOT_PERMITTED). The main app surface is unaffected:
     the SPA never top-level-navigates and the page CSP blocks plain-http
     subresources, so the only cleartext the shell itself speaks stays the
     loopback media server (127.0.0.1:20810, kept explicit below). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
