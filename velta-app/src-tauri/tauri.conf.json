{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velta",
  "identifier": "org.velta",
  "version": "1.4.85",
  "build": {
    "frontendDist": "../../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Velta",
        "width": 1120,
        "height": 740,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-8g+JKwDwKdYL2n4VrSU5f2pYq799ckvbz9HvJpfpNF8='; connect-src 'self' wss: ipc: http://ipc.localhost http://127.0.0.1:* http://blobfile.localhost blobfile:; frame-src 'self' https: http://webxdc.localhost webxdc: http://127.0.0.1:* http://blobfile.localhost blobfile:; img-src 'self' data: blob: file: asset: blobfile: http://blobfile.localhost http://asset.localhost http://127.0.0.1:* http://webxdc.localhost; media-src 'self' blob: asset: blobfile: http://blobfile.localhost http://asset.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "binaries/deltachat-rpc-server-x86_64-pc-windows-msvc.exe": "deltachat-rpc-server.exe",
      "binaries/soartunnel.dll": "soartunnel.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".test"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["velta"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCMjlDODFEM0VBNENFMDIKUldRQ3pxUStIY2dweTIyZ3ZMcEdLTlBpT1lGcEMybmtzdHZnc0xxOVlTbDdDNHZsRVRDcFVoY0QK",
      "endpoints": ["https://github.com/pbuzdin/velta/releases/latest/download/latest.json"]
    }
  }
}
